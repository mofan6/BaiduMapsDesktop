<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="百度地图 · 桌面" Width="1280" Height="820" MinWidth="760" MinHeight="520"
        WindowStyle="None" ResizeMode="CanResize" Background="#F4F7FB"
        FontFamily="Microsoft YaHei UI, Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <Style x:Key="FloatingSurface" TargetType="Border">
      <Setter Property="Background" Value="#F7FFFFFF" />
      <Setter Property="BorderBrush" Value="#C6D3DF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.14" Color="#314564" /></Setter.Value></Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="2" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#35475D" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="15" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}" CornerRadius="8">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#E9F0F8" /><Setter Property="Foreground" Value="#1F65DE" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Background" Value="#D6E5FA" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFace" Property="BorderBrush" Value="#397DEE" /><Setter TargetName="ButtonFace" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.30" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TrafficButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Style.Triggers><DataTrigger Binding="{Binding TrafficActive}" Value="True"><Setter Property="Background" Value="#DFEBFF" /><Setter Property="Foreground" Value="#1F65DE" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="Transparent" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#E5484D" /><Setter Property="Foreground" Value="White" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Background" Value="#C9353D" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#E5484D" /><Setter TargetName="Face" Property="BorderThickness" Value="2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="TextButton" TargetType="Button">
      <Setter Property="Padding" Value="20,11" /><Setter Property="Background" Value="#286BE7" /><Setter Property="Foreground" Value="White" /><Setter Property="Cursor" Value="Hand" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="10"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#1C59C8" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Border x:Name="NativeChrome" Grid.Row="0" Height="54" Background="#FAFCFF" BorderBrush="#DDE5EF" BorderThickness="0,0,0,1" Visibility="{Binding ChromeVisibility}">
      <Grid x:Name="ToolbarLayout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" ToolTip="百度地图 · 拖动窗口 · 双击最大化">
          <Image x:Name="AppBrandIcon" Width="24" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Border>
        <Border Grid.Column="1" Width="{Binding HeaderSearchWidth}" Height="38" VerticalAlignment="Center" Background="White" BorderBrush="#DCE5F0" BorderThickness="1" CornerRadius="9" Visibility="{Binding FeatureVisibility}" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
            <TextBox x:Name="NativeSearchInput" Padding="10,0,4,0" TextAlignment="Left" VerticalContentAlignment="Center" FontSize="14" FontFamily="Microsoft YaHei UI" Foreground="#263B55" BorderThickness="0" Background="Transparent" IsEnabled="{Binding Ready}" AutomationProperties.Name="地图搜索" ToolTip="搜地点、查公交、找路线 · Ctrl + L">
              <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" /></ControlTemplate></TextBox.Template>
            </TextBox>
            <TextBlock Text="搜地点、查公交、找路线" Margin="10,0,4,0" Foreground="#8B99AA" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=NativeSearchInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Button x:Name="NativeSearchButton" Grid.Column="1" Background="#286BE7" Foreground="White" BorderThickness="0" Cursor="Hand" IsEnabled="{Binding Ready}" ToolTip="搜索 · Enter" AutomationProperties.Name="搜索地图">
              <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SearchFace" Background="{TemplateBinding Background}" CornerRadius="0,8,8,0"><Path Data="M15,10 A5,5 0 1 1 5,10 A5,5 0 1 1 15,10 M14,14 L19,19" Width="17" Height="17" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SearchFace" Property="Background" Value="#1F5ED2" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="SearchFace" Property="Background" Value="#194CAB" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
            </Button>
          </Grid>
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding FeatureVisibility}">
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="38" Padding="8,0" Command="{Binding Route}" ToolTip="打开百度路线规划" AutomationProperties.Name="路线">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE70A;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="路线" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" Visibility="{Binding LabelVisibility}" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="38" Command="{Binding Recent}" ToolTip="最近搜索 · 本机保存" AutomationProperties.Name="最近搜索">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="最近" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" Visibility="{Binding LabelVisibility}" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="38" Command="{Binding Favorites}" ToolTip="收藏地图位置 · Ctrl + D" AutomationProperties.Name="收藏">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="收藏" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" Visibility="{Binding LabelVisibility}" /></StackPanel>
          </Button>
          <Border Width="1" Height="20" Background="#DDE4ED" Margin="8,0" VerticalAlignment="Center" />
          <Button Style="{StaticResource TrafficButton}" Width="Auto" MinWidth="64" Command="{Binding Traffic}" ToolTip="打开 / 关闭百度实时路况" AutomationProperties.Name="路况">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="路况" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="64" Command="{Binding Measure}" ToolTip="百度地图测距 · 单击选点，双击结束，Esc 退出" AutomationProperties.Name="测距">
            <StackPanel Orientation="Horizontal" Margin="9,0"><Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,12 L12,3 L17,8 L8,17 Z M5.3,9.7 L6.8,11.2 M7.5,7.5 L9.7,9.7 M9.7,5.3 L11.2,6.8" /><TextBlock Text="测距" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="38" Command="{Binding Screenshot}" ToolTip="矩形框选截图 · Ctrl + Shift + S" AutomationProperties.Name="截图">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="截图" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" Visibility="{Binding LabelVisibility}" /></StackPanel>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="Auto" MinWidth="64" Command="{Binding Share}" ToolTip="打开百度地图原生分享面板" AutomationProperties.Name="分享">
            <StackPanel Orientation="Horizontal" Margin="9,0"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" /><TextBlock Text="分享" FontFamily="Microsoft YaHei UI" FontSize="12" Margin="7,0,0,0" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
          <Button Style="{StaticResource IconButton}" Content="&#xE921;" Command="{Binding Minimize}" ToolTip="最小化" AutomationProperties.Name="最小化" />
          <Button Style="{StaticResource IconButton}" Content="{Binding MaximizeGlyph}" Command="{Binding Maximize}" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Command="{Binding Close}" ToolTip="关闭" AutomationProperties.Name="关闭" />
        </StackPanel>
      </Grid>
    </Border>
    <wv:WebView2 Grid.Row="1" x:Name="Browser" shell:WindowChrome.IsHitTestVisibleInChrome="True" DefaultBackgroundColor="White" Visibility="{Binding BrowserVisibility}" />
    <Border Grid.Row="1" Background="#F4F7FB" Visibility="{Binding CoverVisibility}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="430">
        <Border Background="#E8EFFC" Width="76" Height="76" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,26">
          <Image Source="{Binding Source, ElementName=AppBrandIcon}" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Message}" FontSize="24" FontWeight="SemiBold" Foreground="#172B49" TextAlignment="Center" />
        <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,24" LineHeight="22" />
        <ProgressBar Width="150" Height="3" IsIndeterminate="True" Foreground="#286BE7" BorderThickness="0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
        <Button Style="{StaticResource TextButton}" Content="重新尝试" Command="{Binding Retry}" Visibility="{Binding RetryVisibility}" HorizontalAlignment="Center" />
        <Button Style="{StaticResource TextButton}" Content="在浏览器中打开" Command="{Binding OpenBrowser}" Visibility="{Binding RetryVisibility}" HorizontalAlignment="Center" Margin="0,12,0,0" Background="#65748A" />
      </StackPanel>
    </Border>
    <ProgressBar Grid.Row="0" Height="2" VerticalAlignment="Bottom" IsIndeterminate="True" Foreground="#3E83EB" Background="Transparent" BorderThickness="0" IsHitTestVisible="False" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" />
    <Popup x:Name="NavigationPopup" IsOpen="{Binding NavigationOpen, Mode=OneWay}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
    <Grid Height="150" ClipToBounds="True">
    <Border x:Name="NavigationMotion" Padding="5,3" VerticalAlignment="Bottom" Margin="16,0,16,38">
      <Border.RenderTransform><TranslateTransform Y="120" /></Border.RenderTransform>
      <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource FloatingSurface}">
          <Setter Property="Opacity" Value="0" />
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Command="{Binding Back}" ToolTip="返回 · Alt + ←" AutomationProperties.Name="返回" />
        <Button Style="{StaticResource IconButton}" Content="&#xE72A;" Command="{Binding Forward}" ToolTip="前进 · Alt + →" AutomationProperties.Name="前进" />
        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding Refresh}" ToolTip="刷新 · F5 / Ctrl + R" AutomationProperties.Name="刷新" />
        <Button Style="{StaticResource IconButton}" Content="&#xE80F;" Command="{Binding Home}" ToolTip="地图首页 · Alt + Home" AutomationProperties.Name="地图首页" />
        <Border Width="1" Height="20" Background="#DDE4ED" Margin="7,0" VerticalAlignment="Center" />
        <Button Style="{StaticResource IconButton}" Content="{Binding FullscreenGlyph}" Command="{Binding Fullscreen}" ToolTip="{Binding FullscreenTip}" AutomationProperties.Name="切换全屏" />
        <Button Style="{StaticResource IconButton}" Content="&#xE774;" Command="{Binding OpenBrowser}" ToolTip="在默认浏览器中打开" AutomationProperties.Name="在浏览器打开" />
        <Button Style="{StaticResource IconButton}" Content="&#xE946;" Command="{Binding Help}" ToolTip="帮助与快捷键" AutomationProperties.Name="帮助" />
      </StackPanel>
    </Border>
    </Grid>
    </Popup>
    <Popup x:Name="LibraryPopup" IsOpen="{Binding LibraryOpen, Mode=OneWay}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
    <Border Style="{StaticResource FloatingSurface}" Width="326" Padding="20" MaxHeight="540">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
          <TextBlock Text="{Binding LibraryTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#243B5B" VerticalAlignment="Center" />
          <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" Command="{Binding CloseLibrary}" ToolTip="收起面板" HorizontalAlignment="Right" Width="28" Height="28" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,14,0,14" Visibility="{Binding FavoriteVisibility}">
          <TextBlock Text="为当前地图位置取个名字" Foreground="#64748B" FontSize="12" Margin="0,0,0,8" />
          <TextBox x:Name="FavoriteNameInput" Text="{Binding FavoriteName, UpdateSourceTrigger=PropertyChanged}" Padding="10,9" BorderBrush="#D7E1EF" BorderThickness="1" FontSize="13" MaxLength="100" />
          <Button Style="{StaticResource TextButton}" Content="收藏当前地图" Command="{Binding SaveFavorite}" Margin="0,10,0,0" />
        </StackPanel>
        <Grid Grid.Row="2" MinHeight="110" Margin="0,12,0,0">
          <TextBlock Text="{Binding LibraryEmptyText}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding LibraryEmptyVisibility}" />
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="300">
            <ItemsControl ItemsSource="{Binding LibraryEntries}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="30" /></Grid.ColumnDefinitions>
                  <Button Command="{Binding DataContext.OpenEntry, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch" Background="#F0F5FC" BorderThickness="0" Padding="10,9">
                    <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" Foreground="#243B5B" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7C8CA3" Margin="0,5,0,0" /></StackPanel>
                  </Button>
                  <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="从列表移除" Width="26" Height="28" FontSize="12" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
    </Popup>
    <Popup x:Name="PermissionPopup" IsOpen="{Binding PermissionOpen, Mode=OneWay}" AllowsTransparency="True" StaysOpen="True" PopupAnimation="None">
    <Border Style="{StaticResource FloatingSurface}" Padding="20" Width="320">
      <StackPanel>
        <TextBlock Text="网站权限" FontSize="16" FontWeight="SemiBold" Foreground="#243B5B" />
        <TextBlock Text="{Binding PermissionDetail}" FontSize="13" Foreground="#64748B" TextWrapping="Wrap" LineHeight="22" Margin="0,10,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource TextButton}" Background="#65748A" Content="暂不允许" Command="{Binding DenyPermission}" Margin="0,0,10,0" />
          <Button Style="{StaticResource TextButton}" Content="允许" Command="{Binding AllowPermission}" />
        </StackPanel>
      </StackPanel>
    </Border>
    </Popup>
    <Grid Grid.Row="1" Visibility="{Binding CaptureVisibility}">
      <Image Source="{Binding CaptureImage}" Stretch="Fill" IsHitTestVisible="False" />
      <Canvas x:Name="CaptureCanvas" Background="Transparent" Cursor="Cross" Focusable="True">
        <Path Data="{Binding CaptureMask}" Fill="#880D1728" IsHitTestVisible="False" />
        <Border Canvas.Left="{Binding CaptureLeft}" Canvas.Top="{Binding CaptureTop}" Width="{Binding CaptureWidth}" Height="{Binding CaptureHeight}" BorderBrush="#438BFF" BorderThickness="2" IsHitTestVisible="False" Visibility="{Binding CaptureSelectionVisibility}" />
      </Canvas>
      <Border Style="{StaticResource FloatingSurface}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" Padding="16,12">
        <StackPanel>
          <TextBlock Text="{Binding CaptureHint}" Foreground="#243B5B" FontSize="13" TextAlignment="Center" Margin="0,0,0,10" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource TextButton}" Content="重新框选" Command="{Binding ResetCapture}" Background="#65748A" Padding="14,8" Margin="0,0,8,0" />
            <Button Style="{StaticResource TextButton}" Content="取消" Command="{Binding CancelCapture}" Background="#65748A" Padding="14,8" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.RowSpan="2" BorderBrush="#B8C6D8" BorderThickness="1" IsHitTestVisible="False" />
  </Grid>
</Window>
